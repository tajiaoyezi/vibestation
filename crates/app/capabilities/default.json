{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Vibestation MVP-02 默认 capability · workspace CRUD + greet + dialog 插件 · 最小权限集",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-greet",
    "allow-workspace-init",
    "allow-workspace-list",
    "allow-workspace-create",
    "allow-workspace-open",
    "allow-workspace-delete",
    "allow-workspace-exists",
    "dialog:default"
  ]
}
