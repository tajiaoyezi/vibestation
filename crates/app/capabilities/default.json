{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Vibestation 默认 capability · workspace CRUD + layout + tab CRUD + pane + git + telemetry + dialog 插件 · 最小权限集（theme 走 settings_update · 不再独立 IPC · 见 PR #163 dual-path fix + PR #172 dead code cleanup）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-greet",
    "allow-workspace-init",
    "allow-workspace-list",
    "allow-workspace-create",
    "allow-workspace-open",
    "allow-workspace-delete",
    "allow-workspace-exists",
    "allow-layout-save",
    "allow-layout-load",
    "allow-default-shell-get",
    "allow-default-shell-set",
    "allow-available-shells-list",
    "allow-settings-get",
    "allow-settings-update",
    "allow-tab-list",
    "allow-tab-create",
    "allow-tab-close",
    "allow-tab-rename",
    "allow-tab-reorder",
    "allow-tab-scrollback-fetch",
    "allow-tab-pty-spawn",
    "allow-tab-pty-stdin",
    "allow-tab-pty-resize",
    "allow-tab-pty-signal",
    "allow-tab-pty-kill",
    "allow-pane-pty-spawn",
    "allow-pane-pty-stdin",
    "allow-pane-pty-resize",
    "allow-pane-pty-signal",
    "allow-pane-pty-kill",
    "allow-pane-init-for-tab",
    "allow-pane-split",
    "allow-pane-close",
    "allow-pane-focus",
    "allow-pane-layout-apply",
    "allow-pane-layout-apply-advanced",
    "allow-pane-split-ratio-update",
    "allow-pane-navigate",
    "allow-pane-maximize",
    "allow-pane-resize-step",
    "allow-git-log-query",
    "allow-git-log-commit-detail",
    "allow-git-log-cache-clear",
    "allow-diff-compute",
    "allow-diff-get-settings",
    "allow-diff-set-view-mode",
    "allow-git-status-query",
    "allow-git-status-refresh",
    "allow-git-status-get-settings",
    "allow-git-status-set-group-collapsed",
    "allow-git-status-subscribe",
    "allow-git-status-unsubscribe",
    "allow-git-ops-stage-files",
    "allow-git-ops-unstage-files",
    "allow-git-ops-commit",
    "allow-git-ops-read-identity",
    "allow-git-ops-set-identity",
    "allow-branch-list",
    "allow-branch-create",
    "allow-branch-checkout",
    "allow-branch-delete",
    "allow-branch-switcher-query",
    "allow-git-push",
    "allow-git-pull",
    "allow-git-fetch",
    "allow-git-remote-list",
    "allow-git-auth-provide",
    "allow-git-merge-abort",
    "allow-rebase-start",
    "allow-rebase-continue",
    "allow-rebase-abort",
    "allow-rebase-skip",
    "allow-rebase-interactive-plan",
    "allow-rebase-interactive-apply",
    "allow-merge-start",
    "allow-merge-abort",
    "allow-cherrypick-start",
    "allow-cherrypick-continue",
    "allow-cherrypick-abort",
    "allow-conflict-resolve-file",
    "allow-conflict-status",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-menu-show-tab",
    "allow-menu-show-terminal",
    "allow-menu-register-shortcuts",
    "allow-menu-item-clicked",
    "allow-telemetry-opt-in-set",
    "allow-telemetry-status-get",
    "allow-app-version-get",
    "allow-config-import-scan",
    "allow-config-import-preview",
    "allow-config-import-detect-conflicts",
    "allow-config-import-apply",
    "dialog:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text"
