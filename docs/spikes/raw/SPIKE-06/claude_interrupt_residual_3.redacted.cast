[0.616, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"近的干扰，而是一个真实存在于宇宙深处、\"}},\"session_id\":\"10bdb69b-bb86-4215-accd-a07e9efbe236\",\"parent_tool_use_id\":null,\"uuid\":\"7d86aacb-fc61-4dd0-9272-9e76cdfedef3\"}\r\r\n"]
