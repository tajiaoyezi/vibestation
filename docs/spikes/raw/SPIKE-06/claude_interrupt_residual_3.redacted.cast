[0.296, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"整三十七个小时却始终无人察觉的异常波形——它不属\"}},\"session_id\":\"10bdb69b-bb86-4215-accd-a07e9efbe236\",\"parent_tool_use_id\":null,\"uuid\":\"53140924-9835-4a23-8a8a-937a9200c442\"}\r\r\n"]
