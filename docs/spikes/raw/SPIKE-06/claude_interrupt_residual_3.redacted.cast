[0.221, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"这样一遍又一遍地，从一个爱流泪的物种，传\"}},\"session_id\":\"10bdb69b-bb86-4215-accd-a07e9efbe236\",\"parent_tool_use_id\":null,\"uuid\":\"31fd8f81-c781-4377-b2e2-159e649cb94c\"}\r\r\n"]
