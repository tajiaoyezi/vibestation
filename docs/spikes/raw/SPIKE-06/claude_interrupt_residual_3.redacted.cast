[0.351, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"千四百万光年。林雪薇最初以为是设备故障，连夜调\"}},\"session_id\":\"10bdb69b-bb86-4215-accd-a07e9efbe236\",\"parent_tool_use_id\":null,\"uuid\":\"08c9d24d-3df4-44d3-be6b-0028a265645c\"}\r\r\n"]
