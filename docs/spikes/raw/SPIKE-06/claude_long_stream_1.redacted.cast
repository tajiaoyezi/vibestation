[0.551, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"嗒。门内是一间仅有二十平方米的圆形房间，墙壁由某种从未见\"}},\"session_id\":\"7c33dba4-bb2b-4f69-aa10-e0c323980bc1\",\"parent_tool_use_id\":null,\"uuid\":\"f8828783-9840-4cdb-8b06-416927191c2c\"}\r\n"]
[0.306, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"过的、带有极淡金色纹理的合金构成\"}},\"session_id\":\"7c33dba4-bb2b-4f69-aa10-e0c323980bc1\",\"parent_tool_use_id\":null,\"uuid\":\"e9d31202-ca5c-4d09-a623-eac869ffe42b\"}\r\n"]
