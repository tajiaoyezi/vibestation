[0.377, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"子化的现代结构形成刺眼的时代对比。在房间最深处，她找\"}},\"session_id\":\"7c33dba4-bb2b-4f69-aa10-e0c323980bc1\",\"parent_tool_use_id\":null,\"uuid\":\"69a666e1-7650-4d8e-9fca-fd74b1626f1e\"}\r\n"]
[0.385, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"到了一扇从未出现在任何公开图纸上的金属门。门上刻着三个早已被官方语言体系淘汰的古汉字：\\\"守夜人\\\"。韩\"}},\"session_id\":\"7c33dba4-bb2b-4f69-aa10-e0c323980bc1\",\"parent_tool_use_id\":null,\"uuid\":\"2c463690-ce29-420a-9361-fa2d9b21e6c8\"}\r\n"]
