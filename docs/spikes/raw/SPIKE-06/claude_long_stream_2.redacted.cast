[0.000, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"# 《\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"5b302d6c-5f78-4583-b6b6-cd665b06ef49\"}\r\n"]
[0.056, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"星尘回响》· 中文科幻小说摘要\\n\\n---\\n\\n## 第一章 \"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"798539b2-c2e3-45d7-8443-08c31eccb1c8\"}\r\n"]
[0.424, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"· 觉醒\\n\\n2387 年的木卫二，冰\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"5a802490-5718-4c9e-be82-b492b28bd87d\"}\r\n"]
[0.232, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"壳之下七百米。\\n\\n林澜把\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"c7b67ba3-7afb-4c4d-9fce-8df683911ccc\"}\r\n"]
[0.734, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"脸贴在环形观测窗的内侧，看着下方那\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"7ce5f9df-3d3f-4ac4-8f37-d8c81ce4dab9\"}\r\n"]
[0.459, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"片永不枯竭的黑色海洋。水在舷窗另\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"7bfa4ab2-8c43-4d37-b060-722a228afc0a\"}\r\n"]
[0.241, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"一面缓慢流动，像一只正在呼吸的\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"04ead237-58c9-4e14-8670-7f038ca6f685\"}\r\n"]
[0.361, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"巨兽的皮肤。舷窗的合金骨架还残\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"16846fe4-dfa1-41bf-bb71-4a2e84995f9f\"}\r\n"]
[0.441, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"留着上一代科考站留下的\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"cc4e39cd-9638-403f-ba5a-66f437fdcec6\"}\r\n"]
[0.339, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"刻痕——2281 年，人类第一次在这里\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"f1eb2386-3780-482a-aa51-45a6f36e8ccd\"}\r\n"]
[0.513, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"凿开冰层的时候，把每一个参\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"0870f365-56f3-417d-9679-e8a3c2123cfb\"}\r\n"]
[0.322, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"与者的名字都刻在了金属框上\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"857a9366-edb4-4cb7-a575-3b3d2b3cef37\"}\r\n"]
[0.458, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"。那些名字现在大多已经变成了档案里的一\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"f161dcd2-8426-4fa3-9d61-18ef684e2b33\"}\r\n"]
[0.311, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"串编号。\\n\\n她今年三十七岁，是木卫二记\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"cca449a9-177d-4df9-aed8-5ddc852269d6\"}\r\n"]
[0.432, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"忆档案馆第三代考古语言学家中最\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"c2a84dbf-8237-41e8-ad3e-7c52087e9808\"}\r\n"]
[0.710, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"年轻的一个。档案馆的工作是这样：把\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"97a20ecc-69c7-409a-8c1f-d38853d9d1a5\"}\r\n"]
[0.230, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"从太阳系每一个角落回收回来的信号、\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"a4a9179e-bd76-48c1-b10f-43e4d29ebda3\"}\r\n"]
[0.205, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"数据、残片、破碎文件进行分类、解\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"ddcbe05f-c2da-451e-b1f0-c268493deb46\"}\r\n"]
[0.369, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"码、归档。人类文明在二十三世纪末\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"fb16786b-107a-4823-912e-050f94762f53\"}\r\n"]
[0.510, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"曾经有过一次短暂的星际扩张，又在二十四\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"73c81b5b-f450-4662-94f9-a8f779ee3e73\"}\r\n"]
[0.311, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"世纪初因为一场波及所有殖民地的\\\"认知\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"aaf647e6-4907-411e-8a78-8bc748734c5b\"}\r\n"]
[0.507, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"瘟疫\\\"被迫收缩回太阳系内侧。三百\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"802dc16a-11d1-46ee-a05c-9ad0f8b3d9e5\"}\r\n"]
[0.411, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"多年过去，那些散落在外\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"2d6fdeae-d06d-44ed-943f-6e15bd72a285\"}\r\n"]
[0.445, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"缘行星、柯伊伯带、甚至奥尔特云边缘的观\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"ee56a02f-1e09-4252-b68a-ce4f107d3038\"}\r\n"]
[0.585, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"测设备仍在自动运行，源源不断\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"45d68338-a93b-4d31-ae7c-5437b89c391a\"}\r\n"]
[0.155, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"地把信号回传到内太阳系。大多数信号是\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"f5a174aa-13f1-4423-8223-6e87df682bdb\"}\r\n"]
[0.687, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"噪音，是宇宙背景辐射的随机涨落，是失联探\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"b0a5c939-0dac-4644-8615-9a939d09f3fe\"}\r\n"]
[0.164, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"测器临终前的自检日志。但偶尔——非\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"19485c24-a0b5-4304-9cbb-c5187ce6b529\"}\r\n"]
[0.394, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"常偶尔——会有一些东西，不一样。\\n\\n今\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"2bd930a4-602e-43cc-a3a9-ef50da926f39\"}\r\n"]
[0.377, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"天早上，林澜的解码终端第一次亮起了\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"ada534e6-8bad-46dc-8434-9e694e79a1e0\"}\r\n"]
[0.356, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"从未见过的颜色。\\n\\n那是一种近乎金\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"b8f54fb1-a39f-4041-b5cb-0be256294891\"}\r\n"]
[0.381, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"属的紫色，在系统定义里代表\\\"\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"8bdd9c37-3e9a-44b3-8fba-b7678c978b76\"}\r\n"]
[0.384, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"拓扑异常\\\"。她最初以为是显示故\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"6934a339-2b77-46b9-b8fb-0b0e38b86126\"}\r\n"]
[0.423, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"障，重启了三次，紫色依然固执地停\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"d8871761-34f9-4bb3-a083-e3de9c913c77\"}\r\n"]
[0.430, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"留在主频谱图的左下角，像一\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"5096a139-fc67-40e6-89f1-7d51c5ae97ea\"}\r\n"]
[0.748, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"枚被钉在时间轴上的徽章。信号本身只有十七\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"3f092cd9-8e57-4862-b263-4597f326d745\"}\r\n"]
