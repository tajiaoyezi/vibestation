[0.339, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"话。\\n\\n那是一个很平常的句子。平\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"3465d808-3f09-4140-9a7e-f388a3c3e2a4\"}\r\n"]
[0.362, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"常得几乎称不上哲理，也\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"ce0cb1d9-3a56-4cf1-8225-2b02e155a707\"}\r\n"]
[0.702, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"称不上宏大。但她想，也许真\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"05b9e192-f48e-41cf-869c-ce11a531f2fb\"}\r\n"]
[0.061, "o", "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"正重要的东西，从来就不应该是宏大的。\\n\\n她写\"}},\"session_id\":\"51a86bc6-a365-45a9-aee6-ecc46e288d6d\",\"parent_tool_use_id\":null,\"uuid\":\"be74b0aa-eb74-4e8e-bf3a-0044f984d947\"}\r\n"]
